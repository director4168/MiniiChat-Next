    <string name="builtin_tool_file_delete_schema">{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"要删除的文件或目录绝对路径\"}},\"required\":[\"path\"]}</string>
    <string name="builtin_tool_file_move_schema">{\"type\":\"object\",\"properties\":{\"from\":{\"type\":\"string\",\"description\":\"源路径\"},\"to\":{\"type\":\"string\",\"description\":\"目标路径\"}},\"required\":[\"from\",\"to\"]}</string>
