    <string name="builtin_tool_browser_schema">{\"type\":\"object\",\"properties\":{\"url\":{\"type\":\"string\",\"description\":\"要抓取的URL\"},\"ua\":{\"type\":\"string\",\"description\":\"UA模式：mobile / desktop / custom:&lt;自定义UA&gt;\"},\"timeout_seconds\":{\"type\":\"integer\",\"description\":\"请求超时秒数，默认15\"}},\"required\":[\"url\"]}</string>
